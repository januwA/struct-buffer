{
  "name": "struct-buffer",
  "version": "6.0.0",
  "description": "Add structure to ArrayBuffer",
  "private": false,
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "main": "./dist/cjs/index.cjs",
  "module": "./dist/esm/index.mjs",
  "types": "./dist/types/index.d.ts",
  "unpkg": "./dist/iife/struct-buffer.global.js",
  "jsdelivr": "./dist/iife/struct-buffer.global.js",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/esm/index.mjs",
      "require": "./dist/cjs/index.cjs",
      "default": "./dist/esm/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build:js": "node scripts/build.mjs",
    "build:types": "tsc --project tsconfig.types.json",
    "build": "npm run build:js && npm run build:types",
    "test": "jest"
  },
  "keywords": [
    "struct-buffer",
    "ArrayBuffer",
    "DataView",
    "binary",
    "deserialize",
    "buffer",
    "Struct"
  ],
  "author": "Ajanuw",
  "license": "MIT",
  "homepage": "https://github.com/januwA/struct-buffer",
  "repository": {
    "type": "git",
    "url": "https://github.com/januwA/struct-buffer.git"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "esbuild": "^0.28.2",
    "jest": "^30.5.2",
    "ts-jest": "^29.4.14",
    "typescript": "^5.9.3"
  },
  "dependencies": {}
}
